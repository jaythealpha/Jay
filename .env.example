# Copy to .env and fill in your values. Never commit .env.

# === Meshy AI ===
MESHY_API_KEY=msy_your_key_here

# === Bambu Lab P2S ===
BAMBU_P2S_HOST=192.168.0.10            # LAN IP from printer screen
BAMBU_P2S_SERIAL=00M00A000000000       # printer serial number
BAMBU_P2S_ACCESS_CODE=12345678         # 8-digit LAN access code

# === Bambu Lab A1 ===
BAMBU_A1_HOST=192.168.0.11
BAMBU_A1_SERIAL=00M00B000000000
BAMBU_A1_ACCESS_CODE=12345678

# === Optional: Anthropic (for web URL vision parsing in Phase 3) ===
ANTHROPIC_API_KEY=

# === Storage paths (defaults are fine) ===
BAMBU_AUTO_DATA_DIR=./data
