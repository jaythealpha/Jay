# All Mighty Coupon — development environment example.
# Copy to .env and adjust. Never commit a real .env file.

# API
NODE_ENV=development
API_PORT=3001

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://amc:amc_dev_password@localhost:5432/amc_dev?schema=public

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Optional until the recognition pipeline (Milestone 1) needs it.
# Used to encrypt barcode payloads at rest (AES-256-GCM). Must be 64 hex chars
# (32 bytes) when set — generate with: openssl rand -hex 32
# BARCODE_ENCRYPTION_KEY=
